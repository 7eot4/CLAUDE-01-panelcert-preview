# Lemon Squeezy (Merchant of Record — handles EU VAT / US sales tax for you)
# https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Signing secret configured on the webhook itself (Settings > Webhooks)
LEMONSQUEEZY_WEBHOOK_SECRET=

# Supabase (Postgres) — service role key only, never expose client-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email
RESEND_API_KEY=
EMAIL_FROM="PanelCert <orders@panelcert.com>"

# Random 32+ byte secret used to sign time-limited download links.
# Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# Simple shared-secret gate for /admin (not a full auth system — see README)
ADMIN_PASSWORD=

# Public site URL, used for absolute links in emails and metadata
NEXT_PUBLIC_SITE_URL=https://panelcert.com

# Optional: Plausible Analytics (privacy-friendly, no cookie banner needed)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=panelcert.com
